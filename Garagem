<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IOTGARAGE - Estacionamento Inteligente</title>
    <style>
        /* Fonte do sistema (sem internet) */
        :root {
            --wine: #722f37;
            --wine-light: #9e424d;
            --slate-bg: #0b1120;
            --slate-900: #0f172a;
            --slate-800: #1e293b;
            --slate-700: #334155;
            --slate-400: #94a3b8;
            --text-main: #e2e8f0;
            --emerald: #10b981;
            --red: #ef4444;
            --blue: #3b82f6;
            --amber: #f59e0b;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
        body { background-color: var(--slate-bg); color: var(--text-main); overflow-x: hidden; padding-bottom: 40px; }
        a { text-decoration: none; color: inherit; transition: all 0.2s; }
        button { cursor: pointer; border: none; background: none; font-family: inherit; }

        /* Utilitários de Layout */
        .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
        .flex { display: flex; }
        .flex-col { flex-direction: column; }
        .items-center { align-items: center; }
        .justify-between { justify-content: space-between; }
        .justify-center { justify-content: center; }
        .gap-2 { gap: 8px; } .gap-3 { gap: 12px; } .gap-4 { gap: 16px; } .gap-6 { gap: 24px; } .gap-8 { gap: 32px; }
        .text-center { text-align: center; }
        .text-xs { font-size: 12px; } .text-sm { font-size: 14px; } .text-lg { font-size: 18px; } .text-2xl { font-size: 24px; } .text-5xl { font-size: 48px; }
        .font-bold { font-weight: 700; } .font-black { font-weight: 900; } .font-medium { font-weight: 500; }
        .uppercase { text-transform: uppercase; } .tracking-wider { letter-spacing: 0.05em; }
        .rounded-xl { border-radius: 12px; } .rounded-2xl { border-radius: 16px; } .rounded-3xl { border-radius: 24px; } .rounded-full { border-radius: 9999px; }
        .hidden { display: none; }

        /* Efeito de Vidro */
        .glass { background: rgba(30, 41, 59, 0.6); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.05); }

        /* Header */
        header { position: sticky; top: 0; z-index: 50; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(12px); border-bottom: 1px solid var(--slate-700); }
        .nav-links { display: none; gap: 32px; font-size: 14px; color: var(--slate-400); }
        .nav-links a:hover { color: #fff; transform: scale(1.05); }
        @media (min-width: 768px) { .nav-links { display: flex; } }

        /* Hero */
        .hero { padding: 96px 24px; text-align: center; position: relative; overflow: hidden; }
        .hero::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 500px; height: 500px; background: rgba(114, 47, 55, 0.15); border-radius: 50%; filter: blur(120px); z-index: -1; }
        .hero h2 { font-size: 48px; font-weight: 900; color: #fff; margin-bottom: 24px; line-height: 1.1; }
        .hero h2 span { color: transparent; background-clip: text; -webkit-background-clip: text; background-image: linear-gradient(to right, var(--wine), #ef4444, #f97316); }
        .hero p { font-size: 18px; color: var(--slate-400); max-width: 600px; margin: 0 auto 40px; line-height: 1.6; }
        @media (min-width: 768px) { .hero h2 { font-size: 72px; } }

        /* Títulos de Seção */
        .section-title { display: flex; align-items: center; justify-content: center; gap: 16px; margin-bottom: 32px; margin-top: 48px; }
        .section-title .line { height: 1px; background: var(--slate-700); flex: 1; max-width: 100px; }
        .section-title h3 { font-size: 14px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--slate-400); margin: 0; }

        /* Grids e Cards */
        .grid-hardware { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
        @media (min-width: 768px) { .grid-hardware { grid-template-columns: repeat(3, 1fr); } }
        @media (min-width: 1024px) { .grid-hardware { grid-template-columns: repeat(5, 1fr); } }
        
        .grid-features { display: grid; grid-template-columns: 1fr; gap: 24px; }
        @media (min-width: 768px) { .grid-features { grid-template-columns: repeat(2, 1fr); } }
        @media (min-width: 1024px) { .grid-features { grid-template-columns: repeat(3, 1fr); } }

        .hw-card { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 24px; border-radius: 16px; border: 1px solid var(--slate-700); background: var(--slate-900); transition: all 0.3s; }
        .hw-card:hover { border-color: var(--slate-400); transform: translateY(-2px); }
        .hw-icon { width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 16px; font-size: 28px; }
        .hw-card h4 { font-weight: 700; color: #fff; margin-bottom: 8px; }
        .hw-card p { font-size: 12px; color: var(--slate-400); }

        .feature-card { padding: 24px; border-radius: 16px; border: 1px solid var(--slate-700); background: var(--slate-900); transition: all 0.3s; }
        .feature-card:hover { box-shadow: 0 0 20px rgba(255, 255, 255, 0.05); }
        .feature-card h4 { font-weight: 700; margin-bottom: 12px; display: flex; align-items: center; gap: 8px; }
        .feature-card p { font-size: 14px; color: var(--slate-400); }

        /* Área da Maquete */
        .maquete-section { position: relative; }
        .maquete-layout { display: flex; flex-direction: column; gap: 32px; align-items: center; justify-content: center; }
        @media (min-width: 1024px) { .maquete-layout { flex-direction: row; align-items: flex-start; } }

        /* Painel Físico */
        .garage-panel { width: 100%; max-width: 600px; padding: 32px; border-radius: 24px; border: 1px solid var(--slate-700); position: relative; }
        
        .buzzer-indicator { position: absolute; top: 24px; right: 24px; display: flex; align-items: center; gap: 12px; background: rgba(15, 23, 42, 0.8); padding: 8px 16px; border-radius: 999px; border: 1px solid rgba(245, 158, 11, 0.2); transition: all 0.3s; font-size: 12px; font-weight: 600; color: var(--slate-400); }
        .buzzer-indicator.active { border-color: var(--amber); background: rgba(245, 158, 11, 0.1); color: var(--amber); box-shadow: 0 0 20px rgba(245, 158, 11, 0.3); }
        .wave-container { position: relative; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; }
        .wave { position: absolute; width: 100%; height: 100%; border-radius: 50%; background: var(--amber); opacity: 0; }
        .buzzer-active .wave { animation: radarPing 0.8s cubic-bezier(0, 0, 0.2, 1) infinite; }

        .section-box { margin-bottom: 24px; padding: 20px; background: var(--slate-900); border-radius: 16px; border: 1px solid var(--slate-700); }
        
        .gate-status { padding: 4px 16px; border-radius: 9999px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; background: rgba(239, 68, 68, 0.1); color: var(--red); border: 1px solid rgba(239, 68, 68, 0.3); }
        .gate-status.open { background: rgba(16, 185, 129, 0.2); color: var(--emerald); border-color: rgba(16, 185, 129, 0.5); box-shadow: 0 0 15px rgba(16, 185, 129, 0.3); }

        .btn { width: 100%; padding: 12px; border-radius: 12px; font-weight: 500; display: flex; align-items: center; justify-content: center; gap: 8px; transition: all 0.2s; }
        .btn:active { transform: scale(0.95); }
        .btn-entrada { background: rgba(59, 130, 246, 0.1); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.5); }
        .btn-entrada:hover { background: rgba(59, 130, 246, 0.2); }
        .btn-saida { background: rgba(16, 185, 129, 0.1); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.5); }
        .btn-saida:hover { background: rgba(16, 185, 129, 0.2); }

        /* Vagas Físicas */
        .vaga-container { display: flex; justify-content: space-between; gap: 16px; }
        .vaga { flex: 1; aspect-ratio: 1; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2px solid var(--emerald); background: rgba(16, 185, 129, 0.1); color: var(--emerald); box-shadow: 0 0 15px rgba(16, 185, 129, 0.15); cursor: pointer; transition: all 0.3s; }
        .vaga:hover { transform: translateY(-3px) scale(1.02); }
        .vaga.occupied { border-color: var(--red); background: rgba(239, 68, 68, 0.1); color: var(--red); box-shadow: 0 0 15px rgba(239, 68, 68, 0.2); }
        .vaga .icon { font-size: 32px; margin-bottom: 8px; opacity: 0.3; transition: opacity 0.3s; }
        .vaga.occupied .icon { opacity: 1; }
        .vaga span { font-weight: 700; font-size: 10px; text-transform: uppercase; letter-spacing: 0.05em; }

        /* Mockup iPhone */
        .phone { width: 320px; height: 660px; background: #020617; border-radius: 48px; padding: 8px; border: 8px solid var(--slate-800); position: relative; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.5); flex-shrink: 0; }
        .phone-notch { position: absolute; top: 0; left: 50%; transform: translateX(-50%); height: 28px; width: 128px; background: var(--slate-800); border-bottom-left-radius: 16px; border-bottom-right-radius: 16px; z-index: 20; display: flex; align-items: center; justify-content: center; gap: 8px; }
        .phone-notch div { height: 8px; border-radius: 9999px; background: #020617; }
        .phone-notch .cam { width: 8px; height: 8px; }
        .phone-notch .speaker { width: 32px; height: 8px; }
        
        .phone-screen { height: 100%; background: linear-gradient(to bottom, var(--slate-900), #020617); border-radius: 40px; overflow-y: auto; display: flex; flex-direction: column; scrollbar-width: none; }
        .phone-screen::-webkit-scrollbar { display: none; }

        .app-header { padding: 24px 24px 0; display: flex; justify-content: space-between; color: var(--slate-400); font-size: 10px; font-weight: 500; margin-bottom: 16px; }
        .app-logo { padding: 0 24px; margin-bottom: 24px; }
        .app-logo h4 { font-size: 24px; font-weight: 900; color: var(--wine); }
        .app-logo h4 span { color: #fff; }
        .app-logo p { font-size: 10px; color: var(--slate-400); display: flex; align-items: center; gap: 6px; margin-top: 4px; }
        .dot-green { width: 6px; height: 6px; background: var(--emerald); border-radius: 50%; animation: pulse 2s infinite; }

        .app-content { padding: 0 20px 24px; display: flex; flex-direction: column; gap: 20px; }
        .app-card { background: rgba(30, 41, 59, 0.6); border-radius: 16px; padding: 16px; border: 1px solid var(--slate-700); }
        .app-card h5 { font-size: 10px; color: var(--slate-400); text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; font-weight: 700; }
        
        .app-row { display: flex; justify-content: space-between; align-items: center; padding: 10px; border-radius: 8px; background: rgba(15, 23, 42, 0.8); border: 1px solid var(--slate-800); margin-bottom: 8px; }
        .app-row:last-child { margin-bottom: 0; }
        .app-row span { font-size: 12px; color: var(--slate-400); font-weight: 500; }
        
        .app-badge { font-size: 9px; font-weight: 700; padding: 4px 8px; border-radius: 4px; background: rgba(16, 185, 129, 0.1); color: var(--emerald); text-transform: uppercase; }
        .app-badge.occupied { background: rgba(239, 68, 68, 0.1); color: var(--red); }
        .app-badge.closed { background: rgba(239, 68, 68, 0.1); color: var(--red); }

        .btn-app { width: 100%; padding: 12px; border-radius: 12px; font-size: 12px; font-weight: 700; text-transform: uppercase; display: flex; justify-content: center; align-items: center; gap: 8px; margin-bottom: 8px; transition: 0.2s; }
        .btn-app:last-child { margin-bottom: 0; }
        .btn-app:active { transform: scale(0.95); }
        .btn-app-wine { background: linear-gradient(to right, var(--wine), var(--wine-light)); color: #fff; }
        .btn-app-gray { background: var(--slate-700); color: #fff; }

        .home-indicator { width: 35%; height: 6px; background: rgba(100, 116, 139, 0.5); border-radius: 999px; margin: auto auto 12px; }

        /* Footer */
        footer { border-top: 1px solid var(--slate-800); background: rgba(15, 23, 42, 0.5); padding: 40px 0; text-align: center; font-size: 14px; color: var(--slate-400); margin-top: 64px; }
        .social-icons { font-size: 20px; display: flex; justify-content: center; gap: 16px; margin-bottom: 16px; cursor: pointer; }
        .social-icons span:hover { color: #fff; }

        /* Toasts (Notificações) */
        #toast-container { position: fixed; bottom: 20px; right: 20px; z-index: 50; display: flex; flex-direction: column; gap: 8px; pointer-events: none; }
        .toast { background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(12px); border: 1px solid var(--blue); padding: 12px; border-radius: 8px; box-shadow: 0 10px 15px rgba(0,0,0,0.3); display: flex; align-items: center; gap: 12px; font-size: 12px; font-weight: 500; width: 280px; pointer-events: auto; animation: slideInUp 0.3s ease-out forwards; }
        .toast.mqtt { border-color: #d946ef; color: #f0abfc; }

        /* Animações */
        @keyframes radarPing { 0% { transform: scale(1); opacity: 0.8; } 70% { transform: scale(2.5); opacity: 0; } 100% { transform: scale(2.5); opacity: 0; } }
        @keyframes slideInUp { from { transform: translateY(100%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
        @keyframes pulse { 0% { opacity: 1; } 50% { opacity: 0.5; } 100% { opacity: 1; } }
        
        .fade-out { opacity: 0; transform: translateY(100%); transition: all 0.3s ease; }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="container flex justify-between items-center" style="padding-top: 16px; padding-bottom: 16px;">
            <h1 class="text-2xl font-black text-wine flex items-center gap-2" style="color: var(--wine);">
                🏭 IOT<span style="color: #fff;">GARAGE</span>
            </h1>
            <nav class="nav-links">
                <a href="#arquitetura">Hardware</a>
                <a href="#funcionalidades">Funcionalidades</a>
                <a href="#maquete">Maquete Interativa</a>
            </nav>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <h2>O futuro do estacionamento <br><span>na sua garagem.</span></h2>
        <p>Um ecossistema IoT completo com sensores ultrassônicos, controle de acesso RFID e monitoramento em tempo real via protocolo MQTT.</p>
    </section>

    <!-- Hardware -->
    <section id="arquitetura" class="container">
        <div class="section-title">
            <div class="line"></div>
            <h3>Arquitetura de Hardware</h3>
            <div class="line"></div>
        </div>
        <div class="grid-hardware">
            <div class="hw-card">
                <div class="hw-icon" style="background: rgba(6, 182, 212, 0.1); color: #22d3ee;">🧠</div>
                <h4>Arduino</h4>
                <p>Processamento local e leitura de sensores.</p>
            </div>
            <div class="hw-card">
                <div class="hw-icon" style="background: rgba(168, 85, 247, 0.1); color: #c084fc;">📶</div>
                <h4>ESP32</h4>
                <p>Módulo Wi-Fi e ponte de rede IoT.</p>
            </div>
            <div class="hw-card">
                <div class="hw-icon" style="background: rgba(217, 70, 239, 0.1); color: #e879f9;">🌐</div>
                <h4>MQTT</h4>
                <p>Comunicação leve e em tempo real.</p>
            </div>
            <div class="hw-card">
                <div class="hw-icon" style="background: rgba(59, 130, 246, 0.1); color: #60a5fa;">🆔</div>
                <h4>RFID</h4>
                <p>Acesso seguro via tag/cartão.</p>
            </div>
            <div class="hw-card" style="grid-column: span 2;">
                <div class="hw-icon" style="background: rgba(34, 197, 94, 0.1); color: #4ade80;">🔘</div>
                <h4>Pushbutton</h4>
                <p>Acionamento para saída descomplicada.</p>
            </div>
        </div>
    </section>

    <!-- Funcionalidades -->
    <section id="funcionalidades" class="container">
        <div class="section-title">
            <div class="line"></div>
            <h3>Funcionalidades</h3>
            <div class="line"></div>
        </div>
        <div class="grid-features">
            <div class="feature-card" style="border-color: rgba(6, 182, 212, 0.3); background: linear-gradient(135deg, rgba(6, 182, 212, 0.05), var(--slate-900));">
                <h4 style="color: #22d3ee;">➡️ Entrada RFID</h4>
                <p>O sensor lê a tag do cliente e abre o portão automaticamente ao chegar em casa.</p>
            </div>
            <div class="feature-card" style="border-color: rgba(16, 185, 129, 0.3); background: linear-gradient(135deg, rgba(16, 185, 129, 0.05), var(--slate-900));">
                <h4 style="color: #34d399;">🚗 Monitoramento de Vagas</h4>
                <p>Sensores ultrassônicos e LEDs indicam visualmente se as 3 vagas estão livres ou ocupadas.</p>
            </div>
            <div class="feature-card" style="border-color: rgba(99, 102, 241, 0.3); background: linear-gradient(135deg, rgba(99, 102, 241, 0.05), var(--slate-900));">
                <h4 style="color: #818cf8;">📱 App Mobile & MQTT</h4>
                <p>Visualização do status das vagas e controle dos portões na palma da sua mão.</p>
            </div>
            <div class="feature-card" style="border-color: rgba(245, 158, 11, 0.3); background: linear-gradient(135deg, rgba(245, 158, 11, 0.05), var(--slate-900));">
                <h4 style="color: #fbbf24;">🔊 Assistente de Distância</h4>
                <p>O buzzer aumenta a frequência sonora à medida que o carro se aproxima da parede da garagem.</p>
            </div>
            <div class="feature-card" style="border-color: rgba(20, 184, 166, 0.3); background: linear-gradient(135deg, rgba(20, 184, 166, 0.05), var(--slate-900));">
                <h4 style="color: #2dd4bf;">🚪 Saída Descomplicada</h4>
                <p>Pushbutton interno físico e botão virtual no app para abrir o segundo portão (saída).</p>
            </div>
        </div>
    </section>

    <!-- Maquete -->
    <section id="maquete" class="container" style="margin-top: 48px;">
        <div class="section-title">
            <div class="line"></div>
            <h3>Maquete Interativa</h3>
            <div class="line"></div>
        </div>

        <div class="maquete-layout">
            <!-- Painel Físico -->
            <div class="garage-panel glass">
                <div id="buzzer-container" class="buzzer-indicator">
                    <span>Sensor / Buzzer</span>
                    <div class="wave-container">
                        <span>🔊</span>
                        <div class="wave"></div>
                    </div>
                </div>

                <h4 style="font-size: 24px; font-weight: 700; color: #fff; margin-bottom: 32px; display: flex; align-items: center; gap: 12px;">
                    🏭 Garagem Física
                </h4>

                <!-- Entrada -->
                <div class="section-box">
                    <div class="flex justify-between items-center" style="margin-bottom: 20px;">
                        <span class="font-bold">Portão de Entrada (RFID)</span>
                        <span id="status-cancela-entrada" class="gate-status">Fechado</span>
                    </div>
                    <button onclick="simularRFID()" class="btn btn-entrada">
                        🆔 Aproximar Tag RFID
                    </button>
                </div>

                <!-- Vagas -->
                <div class="section-box">
                    <p style="font-size: 14px; color: var(--slate-400); text-align: center; margin-bottom: 20px;">Vagas Ultrassônicas <span style="font-size: 12px; display: block; margin-top: 4px;">(Clique para simular carro)</span></p>
                    <div class="vaga-container">
                        <div onclick="toggleVaga(1)" id="vaga-1" class="vaga">
                            <div class="icon">🚗</div>
                            <span>Vaga 1</span>
                        </div>
                        <div onclick="toggleVaga(2)" id="vaga-2" class="vaga">
                            <div class="icon">🚗</div>
                            <span>Vaga 2</span>
                        </div>
                        <div onclick="toggleVaga(3)" id="vaga-3" class="vaga">
                            <div class="icon">🚗</div>
                            <span>Vaga 3</span>
                        </div>
                    </div>
                </div>

                <!-- Saída -->
                <div class="section-box" style="margin-bottom: 0;">
                    <div class="flex justify-between items-center" style="margin-bottom: 20px;">
                        <span class="font-bold">Portão de Saída</span>
                        <span id="status-cancela-saida" class="gate-status">Fechado</span>
                    </div>
                    <button onclick="simularPushbutton()" class="btn btn-saida">
                        🔘 Pressionar Pushbutton
                    </button>
                </div>
            </div>

            <!-- App Mockup -->
            <div class="phone">
                <div class="phone-notch">
                    <div class="cam"></div>
                    <div class="speaker"></div>
                </div>
                <div class="phone-screen">
                    <div class="app-header">
                        <span id="clock">9:41</span>
                        <div class="flex gap-2 items-center">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/></svg>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="16" height="10" rx="2" ry="2"/><line x1="22" y1="11" x2="22" y2="13"/></svg>
                        </div>
                    </div>

                    <div class="app-logo">
                        <h4>IOT<span>GARAGE</span></h4>
                        <p><span class="dot-green"></span> Conectado via MQTT</p>
                    </div>

                    <div class="app-content">
                        <!-- Status Portões -->
                        <div class="app-card">
                            <h5>🚪 Status dos Portões</h5>
                            <div class="app-row" style="border-bottom: 1px solid var(--slate-700); padding-bottom: 12px; margin-bottom: 12px;">
                                <span>Entrada</span>
                                <span id="app-status-entrada" class="app-badge closed">Fechado</span>
                            </div>
                            <div class="app-row" style="border: none;">
                                <span>Saída</span>
                                <span id="app-status-saida" class="app-badge closed">Fechado</span>
                            </div>
                        </div>

                        <!-- Controles -->
                        <div class="app-card">
                            <h5>🎮 Controle Remoto</h5>
                            <button onclick="abrirEntradaMQTT()" class="btn-app btn-app-wine">
                                Abrir Entrada
                            </button>
                            <button onclick="abrirSaidaMQTT()" class="btn-app btn-app-gray">
                                Abrir Saída
                            </button>
                        </div>

                        <!-- Monitoramento -->
                        <div class="app-card">
                            <h5>📊 Monitoramento</h5>
                            <div class="app-row">
                                <span>🚗 Vaga 1</span>
                                <span id="app-vaga-1" class="app-badge">LIVRE</span>
                            </div>
                            <div class="app-row">
                                <span>🚗 Vaga 2</span>
                                <span id="app-vaga-2" class="app-badge">LIVRE</span>
                            </div>
                            <div class="app-row">
                                <span>🚗 Vaga 3</span>
                                <span id="app-vaga-3" class="app-badge">LIVRE</span>
                            </div>
                        </div>
                    </div>
                    <div class="home-indicator"></div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="social-icons">
            <span>🐙</span>
            <span>💼</span>
        </div>
        <p>Projeto IOTGARAGE © 2026. Desenvolvido pela empresa mais la ele do brazil kk.</p>
    </footer>

    <!-- Notificações -->
    <div id="toast-container"></div>

    <!-- JavaScript -->
    <script>
        // Relógio
        function updateClock() {
            const now = new Date();
            let h = now.getHours().toString().padStart(2, '0');
            let m = now.getMinutes().toString().padStart(2, '0');
            document.getElementById('clock').textContent = `${h}:${m}`;
        }
        setInterval(updateClock, 1000);
        updateClock();

        // Toasts
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            let isMqtt = type === 'mqtt';
            let icon = isMqtt ? '🌐' : 'ℹ️';

            toast.className = `toast ${isMqtt ? 'mqtt' : ''}`;
            toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;
            
            container.appendChild(toast);
            
            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Lógica das Vagas
        const vagas = { 1: false, 2: false, 3: false };

        function toggleVaga(numero) {
            vagas[numero] = !vagas[numero];
            
            const elFisico = document.getElementById(`vaga-${numero}`);
            const elApp = document.getElementById(`app-vaga-${numero}`);
            const buzzer = document.getElementById('buzzer-container');
            
            if (vagas[numero]) {
                elFisico.classList.add('occupied');
                elApp.textContent = 'OCUPADA';
                elApp.className = 'app-badge occupied';

                buzzer.classList.add('active', 'buzzer-active');
                showToast(`Veículo detectado na Vaga ${numero}`, 'info');

                setTimeout(() => {
                    buzzer.classList.remove('active', 'buzzer-active');
                }, 2000);

            } else {
                elFisico.classList.remove('occupied');
                elApp.textContent = 'LIVRE';
                elApp.className = 'app-badge';
                showToast(`Vaga ${numero} liberada`, 'info');
            }
        }

        // Lógica dos Portões
        function abrirPortao(tipo, isMqtt = false) {
            const elFisico = document.getElementById(`status-cancela-${tipo}`);
            const elApp = document.getElementById(`app-status-${tipo}`);

            if(isMqtt) {
                showToast(`Comando MQTT: Abrir ${tipo}`, 'mqtt');
            } else {
                showToast(`Acesso Físico: Abrindo ${tipo}`, 'info');
            }

            elFisico.textContent = 'Aberto';
            elFisico.classList.add('open');
            
            elApp.textContent = 'Aberto';
            elApp.className = 'app-badge'; // Volta para a cor verde
            
            setTimeout(() => {
                elFisico.textContent = 'Fechado';
                elFisico.classList.remove('open');
                
                elApp.textContent = 'Fechado';
                elApp.className = 'app-badge closed';
            }, 4000);
        }

        function simularRFID() { abrirPortao('entrada', false); }
        function simularPushbutton() { abrirPortao('saida', false); }
        function abrirEntradaMQTT() { abrirPortao('entrada', true); }
        function abrirSaidaMQTT() { abrirPortao('saida', true); }
    </script>
</body>
</html>
